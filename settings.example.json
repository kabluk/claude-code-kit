{
  "permissions": {
    "allow": [
      "mcp__chrome-devtools"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/scripts/task_profiler.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 .claude/scripts/context_monitor.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/thread-check.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/skill-catalog.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/bash-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/stop-cycle.sh"
          }
        ]
      }
    ]
  }
}
